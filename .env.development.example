# MongoDB connection string.
# For a local MongoDB server:
#   MONGO_URI=mongodb://127.0.0.1:27017/angular_login_nodejs
# For MongoDB Atlas:
#   MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/angular_login_nodejs
# Replace the placeholder below with your actual connection string.
MONGO_URI=mongodb://127.0.0.1:27017/angular_login_nodejs

# JWT secrets — must be at least 32 characters each. Generate unique random values.
JWT_SECRET=replace_with_a_random_secret_at_least_32_characters
REFRESH_TOKEN_SECRET=replace_with_a_second_random_secret_at_least_32_characters

PORT=3000
ALLOWED_ORIGINS=http://localhost:4200
NODE_ENV=development
